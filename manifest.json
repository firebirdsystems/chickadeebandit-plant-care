{
  "id": "plant-care",
  "name": "Plant Care",
  "version": "1.2.0",
  "description": "Track watering, fertilizing, and any other care for your household plants. Color-coded urgency shows what needs attention. One tap to log it.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "family",
  "tags": [
    "plants",
    "gardening",
    "watering",
    "care",
    "reminders"
  ],
  "data_access": {
    "reads": [
      "family.members"
    ],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "db_encryption": "off",
  "row_policies": {
    "plants": {
      "kind": "adult_writable"
    },
    "activities": {
      "kind": "adult_writable"
    }
  },
  "nav": {
    "label": "Plants"
  },
  "widget": {
    "label": "Plant Care",
    "size": "small"
  },
  "glance": {
    "source": {
      "kind": "recurring_due"
    },
    "display": {
      "template": "badge",
      "label": "overdue",
      "severity": "warn"
    }
  },
  "resource_limits": {
    "max_db_bytes": 52428800
  },
  "icon": "🪴",
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": [
      "overdue_plants",
      "plants_summary"
    ]
  },
  "digest": {
    "kind": "recurring_due",
    "activity_table": "activities",
    "activity_label_column": "name",
    "activity_icon_column": "icon",
    "interval_column": "interval_days",
    "interval_unit": "days",
    "default_interval": 7,
    "parent": {
      "table": "plants",
      "activity_fk_column": "plant_id",
      "parent_label_column": "name"
    },
    "last_done": {
      "table": "logs",
      "activity_fk_column": "activity_id",
      "timestamp_column": "done_at"
    }
  }
}
