{
  "id": "plant-care",
  "contexts": ["household", "shared_space"],
  "name": "Plant Care",
  "version": "1.2.0",
  "description": "Track watering, fertilizing, and any other care for your household plants. Color-coded urgency shows what needs attention. One tap to log it.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "family",
  "tags": [
    "plants",
    "gardening",
    "watering",
    "care",
    "reminders"
  ],
  "data_access": {
    "reads": [
      "family.members"
    ],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "preload": {
    "plants": {"sql": "SELECT * FROM app_plant_care__plants ORDER BY created_at"},
    "activities": {"sql": "SELECT * FROM app_plant_care__activities ORDER BY plant_id, sort_order, created_at"}
  },
  "db_encryption": "off",
    "member_references": {
      "logs": {
        "column": "done_by",
        "on_removed": "keep"
      }
    },
  "retention": {
    "logs": {
      "default": 365,
      "timestamp_column": "done_at",
      "override_key": "care_history"
    }
  },
  "delete_cascades": {
    "plants": [
      { "table": "activities", "foreign_key": "plant_id" },
      { "table": "logs", "foreign_key": "plant_id" }
    ],
    "activities": [
      { "table": "logs", "foreign_key": "activity_id" }
    ]
  },
  "row_policies": {
    "plants": {
      "kind": "adult_writable"
    },
    "activities": {
      "kind": "adult_writable"
    }
  },
  "nav": {
    "label": "Plants"
  },
  "widget": {
    "label": "Plant Care",
    "size": "small"
  },
  "publishes": [
    "plant_care.logged"
  ],
  "publish_acls": {
    "plant_care.logged": { "require_role": "member" }
  },
  "glance": {
    "source": {
      "kind": "recurring_due"
    },
    "display": {
      "template": "badge",
      "label": "overdue",
      "severity": "warn"
    }
  },
  "resource_limits": {
    "max_db_bytes": 52428800
  },
  "icon": "🪴",
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": [
      "overdue_plants",
      "plants_summary"
    ]
  },
  "digest": {
    "kind": "recurring_due",
    "activity_table": "activities",
    "activity_label_column": "name",
    "activity_icon_column": "icon",
    "interval_column": "interval_days",
    "interval_unit": "days",
    "default_interval": 7,
    "parent": {
      "table": "plants",
      "activity_fk_column": "plant_id",
      "parent_label_column": "name"
    },
    "last_done": {
      "table": "logs",
      "activity_fk_column": "activity_id",
      "timestamp_column": "done_at"
    }
  }
}
